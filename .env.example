# Copy this file to .env and fill in your agent's API token.
#
# Get one from: WhatsApp → Settings → Agents → Create an agent →
# open the agent's chat → Chat info → API key.
WHATSAPP_API_KEY=

# Optional: a default recipient (a WhatsApp user id/phone number). When set,
# any send_*/notify() call that omits `to` sends here instead -- handy for a
# script that always notifies the same person.
WHATSAPP_USER_ID=
