{
  "name": "WhatsApp Agent - Auto Reply (whatsapp-agent MCP)",
  "meta": {
    "instanceId": "example"
  },
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "seconds",
              "secondsInterval": 20
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Every 20s",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-1100, 300]
    },
    {
      "parameters": {
        "jsCode": "// Read the last-seen offset from workflow static data.\nconst data = $getWorkflowStaticData('global');\nreturn [{ json: { offset: data.next_offset ?? null } }];"
      },
      "id": "read-offset",
      "name": "Read stored offset",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-880, 300]
    },
    {
      "parameters": {
        "toolName": "wa_get_updates",
        "toolParameters": "={{ { \"offset\": $json.offset, \"limit\": 50, \"timeout\": 15 } }}",
        "sseEndpoint": "http://localhost:8765/mcp"
      },
      "id": "get-updates",
      "name": "wa_get_updates",
      "type": "n8n-nodes-langchain.mcpClientTool",
      "typeVersion": 1,
      "position": [-660, 300],
      "notes": "Replace sseEndpoint with your `whatsapp-agent mcp --http` URL."
    },
    {
      "parameters": {
        "jsCode": "const data = $getWorkflowStaticData('global');\ndata.next_offset = $json.next_offset;\nreturn $input.all();"
      },
      "id": "store-offset",
      "name": "Store new offset",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-440, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.messages.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "has-messages",
      "name": "Has messages?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-220, 300]
    },
    {
      "parameters": {
        "jsCode": "return $json.messages.map(m => ({ json: m }));"
      },
      "id": "split-messages",
      "name": "Split messages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [0, 220]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Reply helpfully and briefly to this WhatsApp message: {{ $json.text.body }}"
      },
      "id": "llm-reply",
      "name": "Generate reply (LLM)",
      "type": "n8n-nodes-langchain.agent",
      "typeVersion": 1.6,
      "position": [220, 220],
      "notes": "Wire a Chat Model sub-node into this before running."
    },
    {
      "parameters": {
        "toolName": "wa_format_text",
        "toolParameters": "={{ { \"text\": $json.output, \"source\": \"markdown\" } }}",
        "sseEndpoint": "http://localhost:8765/mcp"
      },
      "id": "format-text",
      "name": "wa_format_text",
      "type": "n8n-nodes-langchain.mcpClientTool",
      "typeVersion": 1,
      "position": [440, 220]
    },
    {
      "parameters": {
        "toolName": "wa_send_text",
        "toolParameters": "={{ { \"to\": $('Split messages').item.json.from, \"body\": $json.formatted, \"reply_to\": $('Split messages').item.json.id } }}",
        "sseEndpoint": "http://localhost:8765/mcp"
      },
      "id": "send-text",
      "name": "wa_send_text",
      "type": "n8n-nodes-langchain.mcpClientTool",
      "typeVersion": 1,
      "position": [660, 220]
    }
  ],
  "connections": {
    "Every 20s": {
      "main": [[{ "node": "Read stored offset", "type": "main", "index": 0 }]]
    },
    "Read stored offset": {
      "main": [[{ "node": "wa_get_updates", "type": "main", "index": 0 }]]
    },
    "wa_get_updates": {
      "main": [[{ "node": "Store new offset", "type": "main", "index": 0 }]]
    },
    "Store new offset": {
      "main": [[{ "node": "Has messages?", "type": "main", "index": 0 }]]
    },
    "Has messages?": {
      "main": [[{ "node": "Split messages", "type": "main", "index": 0 }]]
    },
    "Split messages": {
      "main": [[{ "node": "Generate reply (LLM)", "type": "main", "index": 0 }]]
    },
    "Generate reply (LLM)": {
      "main": [[{ "node": "wa_format_text", "type": "main", "index": 0 }]]
    },
    "wa_format_text": {
      "main": [[{ "node": "wa_send_text", "type": "main", "index": 0 }]]
    }
  }
}
